# LIVE AI. Both values are required. Live mode fails closed if either is missing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# Optional attribution headers sent to OpenRouter.
OPENROUTER_SITE_URL=http://localhost:4184
OPENROUTER_APP_NAME=Circuit

# Live planning loop budget.
CIRCUIT_MAX_REPLANS=2
CIRCUIT_AI_TIMEOUT_MS=20000

# OKX Onchain OS Open API. Live market data for the agent workflow.
# Signed requests use the official scheme: HMAC-SHA256(timestamp + METHOD + path + body).
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional OKX overrides.
OKX_BASE_URL=https://web3.okx.com
OKX_TIMEOUT_MS=8000
# OKX_TSLAX_ADDRESS=0x8ad3c73f833d3f9a523ab01476625f269aeb7cf0
# OKX_GOOGLX_ADDRESS=0xe92f673ca36c5e2efd2de7628f815f84807e803f
# OKX_MSTRX_ADDRESS=0xae2f842ef90c0d5213259ab82639d5bbf649b08e

# X Layer Testnet RPC. Override only when needed.
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech/terigon

# Set only after a real X Layer Testnet deployment.
CIRCUIT_MANDATE_REGISTRY=
CIRCUIT_PORTFOLIO_GUARD=

# Onchain judge phase: publisher key for X Layer Testnet authorizeTrade calls.
# Loaded at runtime (never committed). FILE variant: CIRCUIT_PUBLISHER_KEY_FILE=/path/to/key
CIRCUIT_PUBLISHER_KEY=
CIRCUIT_MCP_USERS={\"judge-token\":{\"name\":\"judge\",\"portfolios\":[\"alpha-01\"]}}
CIRCUIT_MCP_PORT=4185
